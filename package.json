{
  "name": "ghost-desktop",
  "version": "1.0.0",
  "description": "Ghost — Works ahead of you.",
  "author": "Ghost",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc --noEmit && vite build && esbuild src/main/main.ts src/main/preload.ts --bundle --platform=node --external:electron --outdir=dist/main --format=cjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "dist": "npm run build && electron-builder --mac dmg zip",
    "preview": "vite --host 127.0.0.1",
    "icons": "node scripts/icons.mjs",
    "format": "prettier --write src tests *.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^44.4.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.ghost.desktop",
    "productName": "Ghost",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "build/icon.icns",
      "build/trayTemplate*.png"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "Ghost"
    }
  }
}
